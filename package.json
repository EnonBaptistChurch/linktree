{
  "name": "linktree",
  "version": "1.0.0",
  "scripts": {
  "dev": "concurrently \"npx @11ty/eleventy --serve\" \"npx @tailwindcss/cli -i ./src/css/input.css -o ./src/css/output.css --watch\"",
  "build": "npx @tailwindcss/cli -i ./src/css/input.css -o ./src/css/output.css && npx @11ty/eleventy"
},
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.1",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.1"
  }
}

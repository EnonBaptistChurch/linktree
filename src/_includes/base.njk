<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ profile.name }} — Links</title>
    <link rel="stylesheet" href="{{ '/css/output.css' | url }}">
  </head>
  <body class="relative min-h-screen flex flex-col items-center justify-start overflow-visible bg-sky-900">

  <!-- Moving background layer -->
  <div class="fixed inset-0 pointer-events-none
              bg-[radial-gradient(circle_at_30%_30%,theme(colors.sky.700),theme(colors.sky.900))]
              bg-[length:200%_200%] animate-bg-shift-1 blur-[80px] opacity-90"></div>

  <div class="fixed inset-0 pointer-events-none
              bg-[radial-gradient(circle_at_70%_70%,theme(colors.blue.500),theme(colors.blue.700))]
              bg-[length:200%_200%] animate-bg-shift-2 blur-[100px] opacity-60"></div>

  <div class="fixed inset-0 pointer-events-none
              bg-[radial-gradient(circle_at_50%_50%,theme(colors.blue.600),theme(colors.sky.800))]
              bg-[length:200%_200%] animate-bg-shift-3 blur-[120px] opacity-50"></div>

  <!-- Foreground content -->
  <div class="relative z-10 w-full max-w-3xl p-8">
    {{ content | safe }}
  </div>

</body>
</html>
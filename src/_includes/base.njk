<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ profile.name }} — Links</title>
    <link rel="stylesheet" href="{{ '/css/output.css' | url }}">
    <style>
      #cloth {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: #031a3a; /* fallback if WebGL is unavailable */
      }
    </style>
  </head>
  <body class="min-h-screen flex items-center justify-center px-4 py-16">
    <canvas id="cloth" aria-hidden="true"></canvas>

    {{ content | safe }}

    <script>
(() => {
  const canvas = document.getElementById('cloth');
  const gl = canvas.getContext('webgl');
  if (!gl) return;

  const vert = `attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;

  const frag = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 u_res;
    uniform float u_time;
    uniform vec3 u_color;

    // large diagonal folds plus a little fine detail
    float height(vec2 p, float t) {
      float v = 0.0;
      v += sin(p.y * 2.2 + p.x * 0.35 + t * 0.80) * 0.60;
      v += sin(p.y * 3.6 - p.x * 0.60 + t * 1.20 + 1.7) * 0.30;
      v += sin(p.x * 1.1 + p.y * 0.80 - t * 0.60) * 0.35;
      v += sin(p.y * 6.0 + p.x * 1.20 + t * 1.60) * 0.06;
      return v;
    }

    void main() {
      float t = u_time;
      vec2 uv = (gl_FragCoord.xy - 0.5 * u_res) / u_res.y;

      // rotate so the folds run from top-left to bottom-right
      float a = -0.55;
      mat2 R = mat2(cos(a), -sin(a), sin(a), cos(a));
      vec2 p = R * uv * 2.2;

      // slow warp so the folds bend like real fabric
      p += 0.30 * vec2(sin(p.y * 1.5 + t * 0.5), cos(p.x * 1.2 + t * 0.4));

      // surface normal from the height field
      const float E = 0.01;
      float dx = height(p + vec2(E, 0.0), t) - height(p - vec2(E, 0.0), t);
      float dy = height(p + vec2(0.0, E), t) - height(p - vec2(0.0, E), t);
      vec3 n = normalize(vec3(-dx / (2.0 * E) * 0.75, -dy / (2.0 * E) * 0.75, 1.0));

      // lighting: shadows fall to deep navy, flat cloth = base blue, lit slopes go a lighter blue
      vec3 deep = vec3(0.01, 0.05, 0.16);
      vec3 L = normalize(vec3(-0.40, 0.50, 0.55));
      float shade = dot(n, L) / L.z;
      vec3 hi = mix(u_color, vec3(1.0), 0.22);
      vec3 col = mix(deep, u_color, clamp(shade, 0.0, 1.0));
      col += hi * max(shade - 1.0, 0.0) * 0.45;

      // narrow glossy streaks along the fold edges
      vec3 H = normalize(L + vec3(0.0, 0.0, 1.0));
      col += hi * 0.25 * pow(max(dot(n, H), 0.0), 55.0);
      col = min(col, vec3(0.55, 0.75, 1.0)); // ceiling so highlights never wash out to white

      // vignette fades to navy rather than black
      vec2 q = gl_FragCoord.xy / u_res;
      float vig = pow(16.0 * q.x * q.y * (1.0 - q.x) * (1.0 - q.y), 0.45);
      col = mix(deep, col, vig);

      // tiny dither to prevent banding in the dark gradients
      col += (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 255.0;

      gl_FragColor = vec4(col, 1.0);
    }`;

  const compile = (type, src) => {
    const s = gl.createShader(type);
    gl.shaderSource(s, src);
    gl.compileShader(s);
    return s;
  };

  const prog = gl.createProgram();
  gl.attachShader(prog, compile(gl.VERTEX_SHADER, vert));
  gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, frag));
  gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
  gl.useProgram(prog);

  gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
  const loc = gl.getAttribLocation(prog, 'a');
  gl.enableVertexAttribArray(loc);
  gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

  const uRes = gl.getUniformLocation(prog, 'u_res');
  const uTime = gl.getUniformLocation(prog, 'u_time');
  gl.uniform3f(gl.getUniformLocation(prog, 'u_color'), 0.03, 0.30, 0.62); // church blue (#084d9e)

  const SCALE = 0.5; // half resolution is plenty for smooth folds
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let last = 4;

  const draw = (t) => {
    last = t;
    gl.uniform1f(uTime, t);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
  };

  const resize = () => {
    canvas.width = Math.round(innerWidth * SCALE);
    canvas.height = Math.round(innerHeight * SCALE);
    gl.viewport(0, 0, canvas.width, canvas.height);
    gl.uniform2f(uRes, canvas.width, canvas.height);
    draw(last);
  };
  addEventListener('resize', resize);
  resize();

  if (!reduced) {
    const start = performance.now();
    const loop = (now) => { draw((now - start) / 1000); requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  }
})();
    </script>
  </body>
</html>
---
layout: base.njk
---

<main class="w-full max-w-sm mx-auto flex flex-col items-center gap-6">

  {# ── Avatar ── #}
  <div class="relative">
    <div class="w-24 h-24 rounded-full ring-4 ring-white/20 overflow-hidden shadow-2xl">
      <img
        src="{{ profile.avatar }}"
        alt="{{ profile.name }}"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-blue-900/30 to-transparent pointer-events-none"></div>
  </div>

  {# ── Name & bio ── #}
  <div class="text-center">
    <h1 class="text-2xl font-bold text-white tracking-tight">{{ profile.name }}</h1>
    <p class="text-sm text-white/70 mt-2">{{ profile.bio }}</p>
    <p class="text-sm text-white/70 mt-2">{{ profile.sermontimes }}</p>
    <p class="text-sm text-white/70 mt-2">{{ profile.address}}</p>
  </div>

  {# ── Links ── #}
  {% set currentCategory = "" %}
{% for link in profile.links %}
  {% if link.category != currentCategory %}
    {% if currentCategory != "" %}
      </ul>
    {% endif %}
    <h3 class="text-center text-white font-semibold my-1">{{ link.category | title }}</h3>
    <ul class="space-y-3 w-full max-w-md mx-auto">
    {% set currentCategory = link.category %}
  {% endif %}
  
  <li class="text-center w-full">
    <a
      href="{{ link.url }}"
      target="_blank"
      rel="noopener noreferrer"
      class="
        flex items-center justify-center w-full
        bg-white/10 hover:bg-white/20
        border border-white/10 hover:border-white/30
        backdrop-blur-sm
        text-white
        text-bold
        rounded-2xl px-5 py-3.5
        transition-all duration-200
        hover:scale-[1.02] hover:shadow-lg hover:shadow-violet-900/40
        active:scale-[0.98]
        group
      "
    >
      <p class="font-medium text-sm text-center">{{ link.label }}</p>
    </a>
  </li>
{% endfor %}
</ul>

</main>
